# Check every 5 minutes. Keep this at 60 seconds or longer.
CHECK_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=25
REQUEST_CONCURRENCY=8
# Optional when running outside Docker and Chrome/Chromium is not auto-detected.
# BROWSER_EXECUTABLE=/absolute/path/to/chromium

# Internship cohort to find (terms starting May-Aug of this year).
TARGET_YEAR=2027
# Your expected graduation date, used for graduation-year eligibility.
GRADUATION_YEAR=2028
GRADUATION_MONTH=4

# Scheduling and politeness.
# Must-include companies are scanned every run; others at most this often.
ADDITIONAL_SCAN_MINUTES=60
# Cap on full-description fetches per run (the rest are picked up next run).
MAX_DESCRIPTION_FETCHES=250
# Refresh cached descriptions after this many hours to catch edits.
DESCRIPTION_REFRESH_HOURS=24
# Minimum seconds between requests to the same host.
HOST_INTERVAL_SECONDS=1.0
# Mark a posting closed when a healthy scan has not seen it for this long.
CLOSE_AFTER_HOURS=24
# Flag a source whose adapter returns zero postings this many runs in a row.
ZERO_RESULT_WARN_RUNS=3
# Where job_matches.csv / job_matches.json are written (defaults to the state folder).
# EXPORT_DIR=/absolute/path/to/data

# true alerts for matching roles already live on the first run.
ALERT_ON_FIRST_RUN=true

# Phone option 1: Telegram (set both values).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phone option 2: ntfy. Use a long random topic name, then subscribe to it in the ntfy app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Optional local overrides:
# SOURCES_PATH=/absolute/path/to/config/sources.json
# STATE_PATH=/absolute/path/to/data/notifier.sqlite3
